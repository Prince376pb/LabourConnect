# Labour Connect Backend Environment Template
# Copy this file to backend/.env and replace placeholders with your local secrets

SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/labour_connect
DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password

# JWT Authentication Secret (Minimum 256 bits / 32 characters)
JWT_SECRET=super_secret_labour_connect_jwt_key_must_be_at_least_32_characters_long_for_hmac256
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Administrative Initial Provisioning (Optional override)
ADMIN_INIT_EMAIL=admin@labourconnect.com
ADMIN_INIT_PASSWORD=Admin@1234
GOOGLE_CLIENT_ID=985298764017-1crfv37vhimfrobheglr2s1oc5s7k3um.apps.googleusercontent.com